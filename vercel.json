{
  "regions": ["lhr1"],
  "buildCommand": "pnpm build",
  "outputDirectory": "dist",
  "crons": [
    {
      "path": "/api/cron/daily",
      "schedule": "15 2 * * *"
    }
  ],
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api?__path=:path*"
    },
    {
      "source": "/p/:slug",
      "destination": "/api?__path=v1/share/:slug"
    }
  ]
}
