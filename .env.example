# Configuration du site U.N.I.O.N

# --- Site public ---
# Origine publique absolue, sans slash final (aperçus Open Graph).
VITE_SITE_URL=""
# Lien d’invitation au groupe WhatsApp (laisser vide pour masquer le bouton).
VITE_WHATSAPP_URL=""
# Adresse e-mail publique du mouvement (publiée uniquement si accord explicite).
VITE_UNION_EMAIL=""
# Affichage des notes internes de travail (false en production).
VITE_DRAFT_NOTES="false"

# --- Neon : quatre accès distincts, aucun secret préfixé par VITE_ ---
# Propriétaire : migrations uniquement, jamais posé sur Vercel.
DATABASE_URL=""
# API publique : lecture du contenu, écriture des suggestions, votes et signalements.
DATABASE_URL_APP=""
# Studio : contenu, modération, réglages, audit.
DATABASE_URL_STUDIO=""
# Sauvegardes : lecture seule, réservé à GitHub Actions.
DATABASE_URL_BACKUP_RO=""
# Facultatif en développement : repli si les variables de rôle sont absentes.
DATABASE_URL_POOLED=""

# --- Secrets de sécurité ---
# Session Studio : 32 caractères minimum. Ancien nom accepté : STUDIO_SECRET.
SESSION_SECRET=""
STUDIO_SECRET=""
# Empreinte HMAC des votes : 32 caractères minimum. Ancien nom accepté : VOTE_SECRET.
VOTE_HMAC_SECRET=""
VOTE_SECRET=""
# Sonde profonde et tâches planifiées.
HEALTH_SECRET=""
REVALIDATE_SECRET=""
CRON_SECRET=""

# --- Instantané public ---
# SNAPSHOT_URL lit l’objet servi par le CDN ; SNAPSHOT_WRITE_URL reçoit les écritures.
SNAPSHOT_URL=""
SNAPSHOT_WRITE_URL=""
SNAPSHOT_PATH="./data/edition.snapshot.json"
# direct (défaut) ou buffered (regroupement des votes).
WRITE_MODE="direct"
PUBLIC_SITE_URL=""

# --- Stockage objet Vercel Blob ---
# Blob public : instantané, images et selfies des demandes de carte.
# Sur Vercel, le jeton s’appelle BLOB_READ_WRITE_TOKEN ; le nom préfixé
# BLOB_PUBLIC_READ_WRITE_TOKEN sert au développement local.
BLOB_PUBLIC_READ_WRITE_TOKEN=""
BLOB_READ_WRITE_TOKEN=""
# URL de base pour construire les liens lisibles des fichiers publics
# (selfies visibles dans les mails bureau/Studio). À définir si le
# blob n'est pas servi depuis la racine du projet.
SELFIE_BLOB_BASE_URL=""
PUBLIC_BLOB_BASE_URL=""
# Blob privé : pièces d'identité des demandes de carte et dumps chiffrés.
# Jamais servi publiquement, accessible uniquement côté serveur.
BLOB_PRIVATE_READ_WRITE_TOKEN=""
BACKUP_AGE_PUBLIC_KEY=""

# --- Cartes de membre (serveur uniquement) ---
MEMBER_DOSSIER_EMAILS=""
MAIL_API_KEY=""
MAIL_API_URL=""
MEMBER_FROM_EMAIL=""
