# Configuration du site U.N.I.O.N

# Origine publique absolue, sans slash final (aperçus Open Graph).
# Remplacer par le domaine définitif lors du déploiement.
VITE_SITE_URL="https://laudesmassamba1-ai.github.io/U.N.I.O.N"

# Session du Studio. Obligatoire, 16 caractères minimum. Ne pas préfixer par VITE_.
STUDIO_SECRET=""

# Secret HMAC des empreintes de vote. À définir et conserver en production.
VOTE_SECRET=""

# Base SQLite de développement. Sur Vercel, prévoir un stockage PostgreSQL.
DATABASE_PATH="./data/union.sqlite"

# Lien d'invitation au groupe WhatsApp (laisser vide pour masquer le bouton)
VITE_WHATSAPP_URL=""

# Adresse e-mail publique du mouvement (publiée uniquement si renseignée avec accord)
VITE_UNION_EMAIL=""

# Affichage des notes internes de travail (false en production)
VITE_DRAFT_NOTES="false"
