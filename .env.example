[TEMPLATE]
# Lien d'invitation au groupe WhatsApp.
# Laisser vide pour masquer les boutons WhatsApp et afficher le message d'attente.
VITE_WHATSAPP_URL=""

# Phrase de passe de démonstration du Studio.
# Ce contrôle est côté navigateur : il ne protège pas réellement la publication.
VITE_STUDIO_CODE="union"

# Adresses e-mail du mouvement (pour les dossiers de membres).
# Ces adresses reçoivent les dossiers de participation.
UNION_EMAIL="unioncg26@gmail.com"
KICHUB_EMAIL="kichub404@gmail.com"

# Service de mail pour les formulaires sans serveur.
# Valeur par défaut : formulaire statique (page d'adhésion sans envoi réel).
VITE_MAIL_SERVICE="static"
